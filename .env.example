# Sao chép file này thành .env rồi chỉnh nếu cần (không bắt buộc, đã có giá trị mặc định)
PORT=3001
# Đường dẫn file database SQLite
DB_PATH=./data/academic.db
# Nguồn được phép gọi API từ trình duyệt: * hoặc danh sách cách nhau dấu phẩy
CORS_ORIGIN=*
# Ghi log mỗi request ra terminal
LOG_REQUESTS=true
